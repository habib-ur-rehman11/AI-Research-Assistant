# Required: get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Any string you make up - shared password between frontend and backend
API_AUTH_KEY=dev-local-key

# --- Weaviate ---
# If using Docker (docker-compose.yml sets this automatically - leave as is):
WEAVIATE_URL=http://localhost:8080

# If running WITHOUT Docker, use Weaviate Cloud instead:
# 1. Sign up free at https://console.weaviate.cloud/
# 2. Create a free Sandbox cluster
# 3. Copy its REST endpoint URL and API key below
# WEAVIATE_URL=https://your-cluster-id.weaviate.network
# WEAVIATE_API_KEY=your-weaviate-cloud-api-key

# --- Redis ---
# If using Docker, leave as is. If running without Docker and Redis installed locally, this is also correct.
REDIS_URL=redis://localhost:6379/0
